# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/

# Environnements virtuels
venv/
env/
.env
.venv/

# Modeles entraines : on ne versionne que les plus legers, pour que le site
# deploye fonctionne des le premier push (sinon aucun modele n'arrive en prod).
models/*.pkl
!models/tfidf_vectorizer.pkl
!models/tfidf_logistic.pkl

# Les gros modeles restent hors de git
models/tfidf_random_forest.pkl
models/imdb_data.pkl

# DistilBERT en entier : les poids font 268 Mo et sont donc exclus. Versionner
# seulement les JSON de config donnerait un demi-modele inutilisable sur un
# clone frais, et trompeur pour qui reprend le projet.
models/distilbert/

# Cache HuggingFace
.cache/
*.cache

# Tests et couverture
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Graphiques et rapports generes automatiquement
metrics/*.png
metrics/*.json

# Fichiers Word (regeneres avec generate_rapport.py)
*.docx
~$*.docx

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# Docker
.dockerignore

# Variables d'environnement
.env.local
.env.production
