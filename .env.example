# Copier ce fichier en .env pour le developpement local
# Ne jamais committer le vrai .env

FLASK_ENV=production
PYTHONUNBUFFERED=1
PORT=5000

# Cle secrete Flask. En production, mettre une vraie valeur aleatoire.
# Pour en generer une : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
